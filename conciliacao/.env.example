# ─────────────────────────────────────────────────────────────────────────────
# Modo de execução: "mock" (sem API) ou "real"
# ─────────────────────────────────────────────────────────────────────────────
MODE=mock

# ─────────────────────────────────────────────────────────────────────────────
# Milvus
# URL base da sua instância Milvus (ex.: https://meuMSP.milvus.com.br/api/v1)
# ─────────────────────────────────────────────────────────────────────────────
MILVUS_BASE_URL=https://suainstancia.milvus.com.br/api/v1
MILVUS_TOKEN=seu_token_milvus_aqui

# ─────────────────────────────────────────────────────────────────────────────
# TeamViewer
# Gerar via TeamViewer Management Console → Apps → Script Token
# Permissões mínimas: Computers & Contacts (read)
# ─────────────────────────────────────────────────────────────────────────────
TEAMVIEWER_TOKEN=seu_script_token_teamviewer_aqui

# ─────────────────────────────────────────────────────────────────────────────
# Conta Azul
# OAuth2 Client Credentials — registrar aplicação em developer.contaazul.com
# Permissões mínimas: invoices:read, products:read, customers:read
# ─────────────────────────────────────────────────────────────────────────────
CONTAAZUL_CLIENT_ID=seu_client_id_aqui
CONTAAZUL_CLIENT_SECRET=seu_client_secret_aqui
CONTAAZUL_TOKEN_URL=https://api.contaazul.com/oauth2/token

# ─────────────────────────────────────────────────────────────────────────────
# Relatório
# ─────────────────────────────────────────────────────────────────────────────
# Período que aparece no cabeçalho do PDF (formato livre, ex.: "Maio/2025")
PERIODO=Maio/2025
# Diretório de saída dos PDFs (relativo ao projeto)
OUTPUT_DIR=saida
