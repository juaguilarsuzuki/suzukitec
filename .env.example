# ──────────────────────────────────────────────
# Django
# ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: DATABASE_URL=postgres://user:pass@localhost:5432/suzukitec

# ──────────────────────────────────────────────
# Redis (Celery broker)
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────
# E-mail
# ──────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
DEFAULT_FROM_EMAIL=relatorios@suzukitec.com.br

# ──────────────────────────────────────────────
# Digisac
# ──────────────────────────────────────────────
DIGISAC_BASE_URL=https://api.digisac.com.br/v1
DIGISAC_TOKEN=seu-token-digisac

# ──────────────────────────────────────────────
# Milvus
# ──────────────────────────────────────────────
MILVUS_BASE_URL=https://api.milvus.com.br/v1
MILVUS_TOKEN=seu-token-milvus

# ──────────────────────────────────────────────
# PRTG
# ──────────────────────────────────────────────
PRTG_BASE_URL=https://seu-prtg.empresa.com.br
PRTG_USERNAME=seu-usuario
PRTG_PASSHASH=seu-passhash
# ou: PRTG_PASSWORD=sua-senha

# ──────────────────────────────────────────────
# Empresa
# ──────────────────────────────────────────────
COMPANY_NAME=Suzuki Tec
COMPANY_LOGO_URL=

# ──────────────────────────────────────────────
# Conciliação de Ativos (conciliacao/)
# ──────────────────────────────────────────────
# mock = sem chamadas reais às APIs; real = produção
CONCILIACAO_MODE=mock
# TeamViewer — Script Token (Management Console → Apps → Script Token)
# Permissão mínima: Computers & Contacts (read)
TEAMVIEWER_TOKEN=seu-script-token-teamviewer
# Conta Azul — OAuth2 Client Credentials (developer.contaazul.com)
# Permissões mínimas: invoices:read, products:read, customers:read
CONTAAZUL_CLIENT_ID=seu-client-id-contaazul
CONTAAZUL_CLIENT_SECRET=seu-client-secret-contaazul
# Período padrão exibido no PDF (ex.: "Maio/2025")
CONCILIACAO_PERIODO=
# Diretório de saída dos PDFs (dentro do container usa o volume media_data)
CONCILIACAO_OUTPUT_DIR=/app/media/conciliacao
